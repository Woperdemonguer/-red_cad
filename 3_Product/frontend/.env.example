# RedCAD Hub — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── Supabase (Required) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Dev/Test Only (Optional) ───────────────────────────────
# Service role key for scripts that bypass RLS (never expose client-side)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For test scripts (scripts/test-rls.js)
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=your-test-password

# ─── App Config ─────────────────────────────────────────────
# Set to "true" to show dev fast-login buttons on /login
# NEXT_PUBLIC_DEV_MODE=true

# Dev fast-login credentials (only used when DEV_MODE=true)
# NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@example.com
# NEXT_PUBLIC_DEV_ADMIN_PASS=your-admin-password
# NEXT_PUBLIC_DEV_CAD_EMAIL=cad@example.com
# NEXT_PUBLIC_DEV_CAD_PASS=your-cad-password

# ─── Vercel Cron (Production) ───────────────────────────────
# Secret used to authenticate Vercel Cron Job calls to /api/keep-alive.
# Set this in the Vercel Dashboard → Settings → Environment Variables.
# Generate with: openssl rand -base64 32
# CRON_SECRET=your-cron-secret-here
