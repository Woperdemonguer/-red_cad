{
    "name": "redcad-hub",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:smoke": "node --env-file=.env.local scripts/smoke_test.js",
        "db:check": "node --env-file=.env.local scripts/db_health_check.js",
        "verify:methodology": "node scripts/verify_methodology.js",
        "preflight": "npm run build && npm run test && npm run verify:methodology",
        "preflight:full": "npm run preflight && npm run db:check && npm run test:smoke"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.99.0",
        "lucide-react": "^0.359.0",
        "next": "14.2.3",
        "react": "^18",
        "react-dom": "^18",
        "react-hot-toast": "^2.6.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "autoprefixer": "^10.4.27",
        "eslint": "^8.57.1",
        "eslint-config-next": "14.2.3",
        "jsdom": "^28.1.0",
        "postcss": "^8.5.8",
        "tailwindcss": "^3.4.19",
        "vitest": "^4.0.18"
    }
}
